{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdi:common.defs",
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 0,
      "items": { "type": "string", "pattern": "^b[0-9]+$" },
      "description": "ocr_block ids that support the sibling value (optional; a missing value just yields weaker provenance)."
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "date_partial": {
      "type": ["string", "null"],
      "maxLength": 24,
      "description": "Date as written or ISO (YYYY-MM-DD preferred; year/month-only or DD-Mon-YYYY accepted). null if absent."
    },
    "coded": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": ["string", "null"] },
        "system": { "type": ["string", "null"] },
        "code": { "type": ["string", "null"] },
        "display": { "type": ["string", "null"] },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "required": ["text"]
    },
    "quantity": {
      "type": ["object", "number", "string", "null"],
      "additionalProperties": true,
      "properties": {
        "value": { "type": ["number", "string", "null"] },
        "unit_text": { "type": ["string", "null"] },
        "unit_ucum": { "type": ["string", "null"] },
        "comparator": { "type": ["string", "null"], "enum": ["<", "<=", ">", ">=", null] },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
