{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdi:opd_note.v3",
  "title": "OPD consultation / advice note extraction (v3)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "extracted_at_confidence"
  ],
  "properties": {
    "patient": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "mrn": {
          "type": [
            "string",
            "null"
          ]
        },
        "age_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "sex": {
          "type": [
            "string",
            "null"
          ],
          "description": "M / F / O or the word as printed (Male/Female); normalised downstream"
        },
        "evidence": {
          "$ref": "cdi:common.defs#/$defs/evidence"
        }
      },
      "description": "patient identity as printed; may be absent/illegible on handwritten notes"
    },
    "encounter_date": {
      "type": [
        "string",
        "null"
      ],
      "$ref": "cdi:common.defs#/$defs/date_partial"
    },
    "prescriber": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "department": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "$ref": "cdi:common.defs#/$defs/evidence"
        }
      }
    },
    "chief_complaints": {
      "type": "array",
      "items": {
        "$ref": "cdi:common.defs#/$defs/coded"
      }
    },
    "diagnoses": {
      "type": "array",
      "items": {
        "$ref": "cdi:common.defs#/$defs/coded"
      }
    },
    "medications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "drug_text"
        ],
        "properties": {
          "drug_text": {
            "type": "string"
          },
          "strength": {
            "$ref": "cdi:common.defs#/$defs/quantity"
          },
          "dose": {
            "$ref": "cdi:common.defs#/$defs/quantity"
          },
          "route": {
            "type": [
              "string",
              "null"
            ]
          },
          "frequency_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_days": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "active",
              "stopped",
              "changed",
              null
            ]
          },
          "evidence": {
            "$ref": "cdi:common.defs#/$defs/evidence"
          }
        }
      }
    },
    "vitals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "$ref": "cdi:common.defs#/$defs/quantity"
          },
          "systolic": {
            "type": [
              "number",
              "null"
            ]
          },
          "diastolic": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidence": {
            "$ref": "cdi:common.defs#/$defs/evidence"
          }
        }
      }
    },
    "advice": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "evidence": {
            "$ref": "cdi:common.defs#/$defs/evidence"
          }
        }
      }
    },
    "follow_up": {
      "type": [
        "string",
        "null"
      ],
      "$ref": "cdi:common.defs#/$defs/date_partial"
    },
    "extracted_at_confidence": {
      "$ref": "cdi:common.defs#/$defs/confidence"
    },
    "notes_for_reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "investigations": {
      "type": "array",
      "description": "tests / imaging ordered or advised on this prescription (e.g. 'CBC', 'KFT', 'X-ray LS spine'). Orders, not results.",
      "items": {
        "$ref": "cdi:common.defs#/$defs/coded"
      }
    },
    "investigation_preparation": {
      "type": "array",
      "description": "preparation instructions for the ordered tests, ONLY if written on the page (for example 'fasting 12 hrs', 'morning sample', 'first-morning urine'). Never add a usual or standard preparation that is not written. An empty array when none is written.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "text"
        ],
        "properties": {
          "type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "fasting",
              "timing",
              "diet",
              "medicine_hold",
              "sample_collection",
              "bring_documents",
              "other",
              null
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "description": "the number in the words (12 for 'fasting 12 hrs'), else null"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string",
            "description": "the original words, copied exactly"
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "the test names (as written) it applies to, or [\"all\"] when it applies to the whole order; empty if unclear"
          },
          "evidence": {
            "$ref": "cdi:common.defs#/$defs/evidence"
          }
        }
      }
    }
  }
}
