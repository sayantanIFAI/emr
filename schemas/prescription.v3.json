{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdi:prescription.v3",
  "title": "Prescription extraction (v3)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "medications",
    "extracted_at_confidence"
  ],
  "properties": {
    "patient": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "mrn": {
          "type": [
            "string",
            "null"
          ]
        },
        "age_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "sex": {
          "type": [
            "string",
            "null"
          ],
          "description": "M / F / O or the word as printed (Male/Female); normalised downstream"
        },
        "evidence": {
          "$ref": "cdi:common.defs#/$defs/evidence"
        },
        "dob": {
          "$ref": "cdi:common.defs#/$defs/date_partial",
          "description": "date of birth exactly as written; null if not written. Never work it out from the age."
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "description": "patient phone number as written (digits exactly); null if absent"
        },
        "address": {
          "type": [
            "string",
            "null"
          ],
          "description": "patient address as written; null if absent"
        },
        "abha_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "ABHA number or address as written; null if absent"
        }
      },
      "description": "patient identity as printed; may be absent/illegible on handwritten notes"
    },
    "encounter_date": {
      "type": [
        "string",
        "null"
      ],
      "$ref": "cdi:common.defs#/$defs/date_partial"
    },
    "prescriber": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "reg_no": {
          "type": [
            "string",
            "null"
          ]
        },
        "department": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "$ref": "cdi:common.defs#/$defs/evidence"
        },
        "designation": {
          "type": [
            "string",
            "null"
          ],
          "description": "post as written (e.g. Consultant Physician); null if absent"
        },
        "qualification": {
          "type": [
            "string",
            "null"
          ],
          "description": "degrees as written (e.g. MBBS, MD); null if absent"
        },
        "clinic": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "the clinic / hospital / organisation printed on the letterhead or stamp",
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "address": {
              "type": [
                "string",
                "null"
              ]
            },
            "phone": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "$ref": "cdi:common.defs#/$defs/evidence"
            }
          }
        },
        "stamp_present": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "true only if a doctor's stamp or seal is visible on the page"
        },
        "signature_present": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "true only if a signature is visible on the page"
        }
      }
    },
    "diagnoses": {
      "type": "array",
      "items": {
        "$ref": "cdi:common.defs#/$defs/coded"
      }
    },
    "medications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "drug_text"
        ],
        "properties": {
          "drug_text": {
            "type": "string"
          },
          "form": {
            "type": [
              "string",
              "null"
            ]
          },
          "strength": {
            "$ref": "cdi:common.defs#/$defs/quantity"
          },
          "dose": {
            "$ref": "cdi:common.defs#/$defs/quantity"
          },
          "route": {
            "type": [
              "string",
              "null"
            ]
          },
          "frequency_text": {
            "type": [
              "string",
              "null"
            ],
            "description": "verbatim, e.g. '1-0-1', 'BD', 'HS', 'SOS'"
          },
          "duration_days": {
            "type": [
              "integer",
              "null"
            ]
          },
          "prn": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "instructions": {
            "type": [
              "string",
              "null"
            ]
          },
          "ambiguous": {
            "type": "boolean",
            "default": false,
            "description": "set true when a value could not be read confidently (e.g. '500?')"
          },
          "evidence": {
            "$ref": "cdi:common.defs#/$defs/evidence"
          }
        }
      }
    },
    "advice": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "evidence": {
            "$ref": "cdi:common.defs#/$defs/evidence"
          }
        }
      }
    },
    "vitals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "e.g. 'BP', 'weight'"
          },
          "value": {
            "$ref": "cdi:common.defs#/$defs/quantity"
          },
          "systolic": {
            "type": [
              "number",
              "null"
            ]
          },
          "diastolic": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidence": {
            "$ref": "cdi:common.defs#/$defs/evidence"
          }
        }
      }
    },
    "follow_up": {
      "type": [
        "string",
        "null"
      ],
      "description": "the doctor's instruction to come back or review, copied exactly as written (e.g. 'review after 2 weeks'); null if none is written"
    },
    "extracted_at_confidence": {
      "$ref": "cdi:common.defs#/$defs/confidence"
    },
    "notes_for_reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "investigations": {
      "type": "array",
      "description": "tests / imaging ordered or advised on this prescription, each exactly as written. Orders, not results. Never a medicine, and never a test that is not written on the page.",
      "items": {
        "$ref": "cdi:common.defs#/$defs/coded"
      }
    },
    "investigation_preparation": {
      "type": "array",
      "description": "preparation instructions for the ordered tests, ONLY if written on the page (for example 'fasting 12 hrs', 'morning sample', 'first-morning urine'). Never add a usual or standard preparation that is not written. An empty array when none is written.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "text"
        ],
        "properties": {
          "type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "fasting",
              "timing",
              "diet",
              "medicine_hold",
              "sample_collection",
              "bring_documents",
              "other",
              null
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "description": "the number in the words (12 for 'fasting 12 hrs'), else null"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string",
            "description": "the original words, copied exactly"
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "the test names (as written) it applies to, or [\"all\"] when it applies to the whole order; empty if unclear"
          },
          "evidence": {
            "$ref": "cdi:common.defs#/$defs/evidence"
          }
        }
      }
    }
  }
}
