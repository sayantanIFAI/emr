# CDI-Adapter env for the RunPod pod (native services on localhost).
CDI_ENV=runpod
CDI_LOG_LEVEL=INFO
CDI_LOG_JSON=false

CDI_DATABASE_URL=postgresql+psycopg://cdi:cdi@127.0.0.1:5432/cdi
CDI_REDIS_URL=redis://127.0.0.1:6379/0

CDI_S3_ENDPOINT_URL=http://127.0.0.1:9000
CDI_S3_ACCESS_KEY=cdiadmin
CDI_S3_SECRET_KEY=cdiadminsecret
CDI_S3_BUCKET=cdi-documents
CDI_S3_REGION=us-east-1

CDI_INBOX_DIR=/workspace/data/inbox
CDI_PROCESSED_DIR=/workspace/data/processed
CDI_FAILED_DIR=/workspace/data/failed
CDI_PAGE_DPI=200

# web app - bind the one RunPod-proxied HTTP port on this pod (8888, was jupyter).
# Live URL:  https://<RUNPOD_POD_ID>-8888.proxy.runpod.net
CDI_WEBAPP_PORT=8888

# model gateway (cdi_adapter.mlserve) - transformers Qwen2.5-VL, bf16
CDI_MLSERVE_URL=http://127.0.0.1:8077
CDI_MLSERVE_PORT=8077
CDI_MLSERVE_BACKEND=hf
CDI_VLM_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
CDI_VLM_FALLBACK_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
CDI_VLM_DTYPE=bfloat16

CDI_OCR_ENGINE=rapidocr
CDI_HANDWRITTEN_USES_VLM=true

CDI_LLM_BASE_URL=http://127.0.0.1:8000/v1
CDI_DSLM_MODEL=cdi-dslm

CDI_IG_PACKAGE=nrces.fhir.r4.ndhm#6.5.0
